<?xml version='1.0' encoding='utf-8'?>

<section
  xml:id="sec-features-blocks"
  xmlns:xi="http://www.w3.org/2001/XInclude"
>
  <title>Environments and Blocks</title>



This is a paragraph.

\begin{definition}
  The definition of a definition. \term{Defined term}. \textbf{Bold text}.
\end{definition}

\begin{theorem}
  Theorem statement.
\end{theorem}

  \begin{proof}
    Proof of theorem.
  \end{proof}
  \par
Another paragraph.



  <theorem>
    <statement>
      <p>Theorem statement.</p>
    </statement>

    <proof>
      <p>Proof of theorem.</p>
    </proof>
  </theorem>

  <example>
    <statement>
      <idx><h>Testing</h></idx>
      <p>Statement of example</p>
    </statement>
    <solution>
      <p>The solution.</p><p>Another paragraph.</p>
    </solution>
  </example><p>Now a figure.</p>
  <figure>
    <caption>A frog</caption>
    <image source="frog.jpg" width="50%">
      <description>A nice-looking frog with a longish description.</description>
    </image>
  </figure>
</section>
