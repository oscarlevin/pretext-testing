	<section xml:id="sec-prefigure">
		<title>PreFigure Example</title>

<figure xml:id="prefig">
  <caption>Graph of a function and its derivative</caption>
  <image width="60%">
    <prefigure label="prefigure-diffeq" xmlns="https://prefigure.org">
    <diagram dimensions="(300,300)" margins="5">
    <definition>
      f(t,y) = (y[1], -pi*y[0]-0.3*y[1])
    </definition>
    <coordinates bbox="[-1,-3,6,3]">
    <grid-axes xlabel="t"></grid-axes>
    <de-solve function="f" t0="0" t1="bbox[2]" y0="(0,2)" name="oscillator" N="200"></de-solve>
    <plot-de-solution at="x" solution="oscillator" axes="(t,y0)"></plot-de-solution>
    <plot-de-solution at="xprime" solution="oscillator" axes="(t,y1)" stroke="red" tactile-dash="9 9"></plot-de-solution>
    <legend at="legend" anchor="(bbox[2], bbox[3])" alignment="sw" scale="0.9" opacity="0.5">
    <item ref="x"><m>x(t)</m></item>
    <item ref="xprime"><m>x'(t)</m></item>
    </legend>
    </coordinates>
    </diagram>
    </prefigure>

    <description>
      <p>
        The graphs of a function <m>x(t)</m> and its derivative <m>x'(t)</m> are shown in a coordinate plane. Note that the slope of each point of the graph of <m>x(t)</m> is equal to the vertical coordinate of the graph of <m>x'(t)</m> at the same <m>t</m>-value.
      </p>
    </description>

    <shortdescription>
      The graphs of a function x(t) and its derivative x'(t).
    </shortdescription>
  </image>
</figure>

<figure>
  <caption>Graph of a function and its derivative</caption>
  <image width="60%">
    <prefigure label="prefigure-diffeq-b" xmlns="https://prefigure.org">
    <diagram dimensions="(300,300)" margins="5">
    <definition>
      f(t,y) = (y[1], -pi*y[0]-0.3*y[1])
    </definition>
    <coordinates bbox="[-1,-3,6,3]">
    <grid-axes xlabel="t"></grid-axes>
    <de-solve function="f" t0="0" t1="bbox[2]" y0="(0,2)" name="oscillator" N="200"></de-solve>
    <plot-de-solution at="x" solution="oscillator" axes="(t,y0)"></plot-de-solution>
    <plot-de-solution at="xprime" solution="oscillator" axes="(t,y1)" stroke="red" tactile-dash="9 9"></plot-de-solution>
    <legend at="legend" anchor="(bbox[2], bbox[3])" alignment="sw" scale="0.9" opacity="0.5">
    <item ref="x"><m>x(t)</m></item>
    <item ref="xprime"><m>x'(t)</m></item>
    </legend>
    </coordinates>
    </diagram>
    </prefigure>

    <description>
      <p>
        The graphs of a function <m>x(t)</m> and its derivative <m>x'(t)</m> are shown in a coordinate plane. Note that the slope of each point of the graph of <m>x(t)</m> is equal to the vertical coordinate of the graph of <m>x'(t)</m> at the same <m>t</m>-value.
      </p>
    </description>

    <shortdescription>
      The graphs of a function x(t) and its derivative x'(t).
    </shortdescription>
  </image>
</figure>

