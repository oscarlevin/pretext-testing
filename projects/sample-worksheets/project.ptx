<!--
    Stand-alone manifest, for building this project on its own from
    inside this directory.  The repository's top-level project.ptx
    carries the "sw-web" and "sw-pdf" targets used by the test suite.
-->
<project>
  <targets>
    <target name="html">
      <format>html</format>
      <source>sample-worksheets.ptx</source>
      <publication>publication.xml</publication>
      <output-dir>output/html</output-dir>
    </target>
    <target name="latex">
      <format>latex</format>
      <source>sample-worksheets.ptx</source>
      <publication>publication.xml</publication>
      <output-dir>output/latex</output-dir>
    </target>
    <target name="pdf">
      <format>pdf</format>
      <source>sample-worksheets.ptx</source>
      <publication>publication.xml</publication>
      <output-dir>output/pdf</output-dir>
    </target>
  </targets>
</project>
