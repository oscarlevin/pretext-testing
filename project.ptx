<?xml version="1.0" encoding="UTF-8"?>

<project ptx-version="2" output-dir="test-output" source="projects" publication=".">
    <targets>
      <target name="sa-web" format="html" source="sample-article/sample-article.xml" publication="projects/sample-article/publication.xml" deploy="yes" />
      <target name="sa-tex" format="latex" source="sample-article/sample-article.xml" publication="projects/sample-article/publication.xml" deploy="yes"/>
      <target name="sa-pdf" format="pdf" source="sample-article/sample-article.xml" publication="projects/sample-article/publication.xml" latex-source="yes" deploy="yes"/>
      <target name="sa-epub" format="epub" source="sample-article/sample-article.xml" publication="projects/sample-article/publication.xml" deploy="yes"/>
      <target name="sb-web" format="html" source="sample-book/sample-book.xml" publication="projects/sample-book/publication-noparts.xml" deploy="yes"/>
      <target name="sb-tex" format="latex" source="sample-book/sample-book.xml" publication="projects/sample-book/publication-noparts.xml" deploy="yes"/>

      <target name="sa-portable" format="html" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-portable.xml" deploy="yes"/>
      <target name="sa-theme" format="html" source="sample-research-article/sample-article.xml" publication="publisher-files/sample-article/publication-theme.xml" deploy="yes"/>

      <!-- Slide show testing -->

      <target name="slides-web" format="revealjs" source="sample-slideshow/sample-slideshow.xml" publication="projects/sample-slideshow/publication.xml" deploy="yes"/>

      <target name="demo-portable" format="html" source="demo-template/source/main.ptx" publication="projects/demo-template/publication/publication.ptx" deploy="yes"/>


      <!-- Webwork testing -->

      <target name="ww-web" format="html" source="webwork/sample-chapter/sample-chapter.ptx" publication="projects/webwork/sample-chapter/publisher/publication.xml" deploy="yes"/>
      <target name="ww-tex" format="latex" source="webwork/sample-chapter/sample-chapter.ptx" publication="projects/webwork/sample-chapter/publisher/publication.xml" deploy="yes"/>
      <target name="ww-pdf" format="pdf" source="webwork/sample-chapter/sample-chapter.ptx" publication="projects/webwork/sample-chapter/publisher/publication.xml" deploy="yes"/>
      <target name="ww-min-web" format="html" source="webwork/minimal/mini.ptx" publication="projects/webwork/minimal/publication.xml" deploy="yes"/>

      <!-- Braille testing -->
      <target name="braille" format="braille" source="braille/braille-test.xml" publication="projects/braille/publication.xml" deploy="yes"/>

      <!-- Journal testing -->
      <target name="sa-ams" format="latex" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-ams.xml" deploy="yes"/>
      <target name="sa-ams-pdf" format="pdf" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-ams.xml" deploy="yes"/>
      <target name="sa-trans" format="pdf" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-trans.xml" deploy="yes"/>
      <target name="sa-sn" format="latex" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-sn.xml" deploy="yes"/>
      <target name="sa-elsv" format="pdf" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-elsv.xml" deploy="yes"/>
      <target name="sa-ejc" format="pdf" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-ejc.xml" deploy="yes"/>
      <target name="sa-tf" format="pdf" source="sample-article/sample-article.xml" publication="publisher-files/sample-article/publication-tf.xml" deploy="yes"/>
    </targets>
  </project>
